# ============================================================
#  AstroVeda Backend — Environment TEMPLATE
#  Isko copy karke `.env` banao aur apni values daalo.
#  NEVER commit the real .env (only this .example file).
# ============================================================

# ── Server ──
PORT=5000

# ── Auth (JWT) ──
# Production mein isko lamba random string banao.
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# ── CORS (allowed frontend origins, comma-separated) ──
CLIENT_ORIGIN=http://localhost:3000

# ── Database (MongoDB Atlas) ──
# Atlas → Database → Connect → Drivers se URI copy karo.
# URI ke andar <db-name> (astroveda) zaroor add karo.
MONGODB_USERNAME=your_db_user
MONGODB_PASSWORD=your_db_password
MONGODB_DB=astroveda
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/astroveda?retryWrites=true&w=majority&appName=Cluster0"
# Optional: agar local DNS (127.0.0.1) mongodb+srv SRV lookup refuse kare, public DNS set karo
DNS_SERVERS=8.8.8.8,1.1.1.1

# ── AI provider (predictions) ──
# AI_PROVIDER: gemini | groq | ollama | anthropic
AI_PROVIDER=gemini
AI_MODEL=gemini-3.6-flash
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
